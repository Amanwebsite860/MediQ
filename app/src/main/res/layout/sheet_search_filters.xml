<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filters"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="Reset"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView style="@style/TextAppearance.MediQ.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Show" android:textSize="15sp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/chipTypeAll" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Everything" />
                <com.google.android.material.chip.Chip android:id="@+id/chipTypeHospitals" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hospitals" />
                <com.google.android.material.chip.Chip android:id="@+id/chipTypeDoctors" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doctors" />
            </com.google.android.material.chip.ChipGroup>

            <TextView style="@style/TextAppearance.MediQ.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Sort by" android:textSize="15sp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/sortRecommended" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recommended" />
                <com.google.android.material.chip.Chip android:id="@+id/sortNearest" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nearest" />
                <com.google.android.material.chip.Chip android:id="@+id/sortRating" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Top rated" />
                <com.google.android.material.chip.Chip android:id="@+id/sortFee" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fee: low to high" />
                <com.google.android.material.chip.Chip android:id="@+id/sortExperience" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Most experienced" />
            </com.google.android.material.chip.ChipGroup>

            <TextView style="@style/TextAppearance.MediQ.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Specialty" android:textSize="15sp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSpecialty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView style="@style/TextAppearance.MediQ.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Minimum rating" android:textSize="15sp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/ratingAny" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Any" />
                <com.google.android.material.chip.Chip android:id="@+id/rating35" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3.5 ★+" />
                <com.google.android.material.chip.Chip android:id="@+id/rating40" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.0 ★+" />
                <com.google.android.material.chip.Chip android:id="@+id/rating45" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.5 ★+" />
            </com.google.android.material.chip.ChipGroup>

            <TextView style="@style/TextAppearance.MediQ.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Consultation fee (doctors)" android:textSize="15sp" />
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/feeAny" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Any" />
                <com.google.android.material.chip.Chip android:id="@+id/fee300" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Up to ₹300" />
                <com.google.android.material.chip.Chip android:id="@+id/fee500" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Up to ₹500" />
                <com.google.android.material.chip.Chip android:id="@+id/fee1000" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Up to ₹1000" />
            </com.google.android.material.chip.ChipGroup>

            <TextView style="@style/TextAppearance.MediQ.SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="More" android:textSize="15sp" />
            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.chip.Chip android:id="@+id/chipAvailToday" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doctors available today" />
                <com.google.android.material.chip.Chip android:id="@+id/chipEmergency" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚑 24x7 emergency hospitals" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilters"
        style="@style/Widget.MediQ.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="Show results" />
</LinearLayout>
