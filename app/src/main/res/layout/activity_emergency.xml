<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/include_toolbar_simple" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/btnCallAmbulance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sos_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚑"
                    android:textSize="44sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Call Ambulance (108)"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Opens your dialer — you confirm the call"
                    android:textColor="#FFEBEE"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
    android:layout_weight="1"
    android:layout_height="46dp"
    android:layout_width="0dp"
                    android:id="@+id/btnCallPolice"
                    style="@style/Widget.MediQ.QuickDial"
                    android:text="👮  Police 112" />

                <TextView
    android:layout_weight="1"
    android:layout_height="46dp"
    android:layout_width="0dp"
                    android:id="@+id/btnCallContact"
                    style="@style/Widget.MediQ.QuickDial"
                    android:layout_marginStart="10dp"
                    android:text="👤  My contact" />
            </LinearLayout>

            <TextView
    android:layout_height="wrap_content"
    android:layout_width="wrap_content"
                style="@style/TextAppearance.MediQ.SectionTitle"
                android:layout_marginTop="24dp"
                android:text="24x7 emergency hospitals" />

            <LinearLayout
                android:id="@+id/layoutEmergencyHospitals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="No 24x7 hospitals listed yet."
                android:textColor="@color/colorTextSecondary"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
