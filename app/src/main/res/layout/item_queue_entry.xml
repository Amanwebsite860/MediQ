<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutQueueItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <!-- Person Icon / Avatar -->
    <ImageView
        android:id="@+id/ivPersonIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_person" />

    <!-- Token Number -->
    <TextView
        android:id="@+id/tvTokenNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="A-12" />

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:background="@drawable/bg_badge_your_turn"
        tools:text="Your Turn Next"
        tools:textColor="@color/colorQueueYourTurn" />

</LinearLayout>
