<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MediQApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediQ">

        <!-- Splash Screen -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MediQ.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Screens -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:theme="@style/Theme.MediQ.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.SignupActivity"
            android:theme="@style/Theme.MediQ.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.OtpVerificationActivity"
            android:theme="@style/Theme.MediQ.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.ResetPasswordActivity"
            android:theme="@style/Theme.MediQ.Auth"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (Bottom Navigation host) -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Patient Screens -->
        <activity
            android:name=".ui.patient.SearchActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.patient.NearbyHospitalsActivity" />
        <activity android:name=".ui.patient.MapViewActivity" />
        <activity android:name=".ui.patient.HospitalDetailsActivity" />
        <activity android:name=".ui.patient.DoctorListActivity" />
        <activity android:name=".ui.patient.DoctorProfileActivity" />

        <service
            android:name=".service.QueueWatcherService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Staff (doctor / receptionist) flow -->
        <activity android:name=".ui.staff.StaffOnboardingActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.staff.HospitalFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.staff.PendingApprovalActivity" />
        <activity android:name=".ui.staff.ReceptionistHomeActivity" />
        <activity android:name=".ui.staff.DoctorHomeActivity" />

        <activity android:name=".ui.patient.PickLocationActivity" />
        <activity android:name=".ui.patient.NotificationsActivity" />
        <activity android:name=".ui.patient.FavoritesActivity" />
        <activity android:name=".ui.patient.EmergencyActivity" />

        <!-- Appointment Screens -->
        <activity android:name=".ui.appointments.BookAppointmentActivity" />
        <activity android:name=".ui.appointments.AppointmentConfirmationActivity" />

        <!-- Queue Screens -->
        <activity android:name=".ui.queue.LiveQueueActivity" />

    </application>

</manifest>